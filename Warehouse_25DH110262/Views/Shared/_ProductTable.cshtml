@using Warehouse_25DH110262.Models
@model IEnumerable<Product>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th><th>Tên sản phẩm</th><th>Danh mục</th>
            <th>Đơn giá</th><th>Tồn kho</th><th>Mức giá</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductID</td>
                <td>@p.ProductName</td>
                <td>@p.Category</td>
                <td>@PriceHelper.Money(p.Price)</td>
                <td>@p.Quantity</td>
                <td>@PriceHelper.GetLevel(p.Price)</td>
                <td>@Html.ActionLink("Sửa", "Edit", new { id = p.ProductID })</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center">Không có sản phẩm nào.</td></tr>
        }
    </tbody>
</table>
